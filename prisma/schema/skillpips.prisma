// SkillPips domain models — moved verbatim from the original schema.prisma.

model Course {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  thumbnail   String?
  level       String
  duration    Int      // in minutes
  isPublished Boolean  @default(false)
  isPremium   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String?  @db.Text
  videoUrl    String?
  duration    Int      @default(0)
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Signal {
  id         String       @id @default(cuid())
  pair       String
  type       SignalType
  entry      Float
  tp1        Float
  tp2        Float?
  tp3        Float?
  sl         Float
  riskReward String?
  confidence SignalConfidence @default(MEDIUM)
  analysis   String       @db.Text
  status     SignalStatus @default(ACTIVE)
  pips       Float?
  isVipOnly  Boolean      @default(false)
  postedAt   DateTime     @default(now())
  closedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum SignalType {
  BUY
  SELL
}

enum SignalStatus {
  ACTIVE
  CLOSED_WIN
  CLOSED_LOSS
  CANCELLED
}

enum SignalConfidence {
  LOW
  MEDIUM
  HIGH
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  pair      String
  type      String
  entry     Float
  exit      Float?
  sl        Float?
  tp        Float?
  pips      Float?
  riskAmount Float?
  notes     String?  @db.Text
  mood      String?
  tags      String[]
  enteredAt DateTime
  exitedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
