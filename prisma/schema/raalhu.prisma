// Raalhu AI domain models. All tables are prefixed `raalhu_` via @@map.
//
// Multi-tenancy: every domain row hangs off an Organization. Users join via
// Membership. Fields like `createdById` are plain indexed user-id strings
// (not relations) to keep churn on the shared User model minimal.

model Organization {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  plan      RaalhuPlan @default(FREE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  memberships       Membership[]
  businessProfile   BusinessProfile?
  conversations     Conversation[]
  agentRuns         AgentRun[]
  campaigns         Campaign[]
  contentItems      ContentItem[]
  contacts          Contact[]
  notifications     RaalhuNotification[]
  auditLogs         AuditLog[]
  apiKeys           ApiKey[]
  socialAccounts    SocialAccount[]
  autopilotSettings AutopilotSettings?

  @@map("raalhu_organizations")
}

enum RaalhuPlan {
  FREE
  STARTER
  GROWTH
  SCALE
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("raalhu_memberships")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model BusinessProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  businessName   String
  industry       String?
  description    String?  @db.Text
  targetAudience String?  @db.Text
  brandVoice     String?  @db.Text
  websiteUrl     String?
  goals          Json?
  socialLinks    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("raalhu_business_profiles")
}

// Opt-in daily automation: generates a draft content batch on a schedule.
// Never publishes on its own — output lands as DRAFT for a human to review.
model AutopilotSettings {
  id             String    @id @default(cuid())
  organizationId String    @unique
  enabled        Boolean   @default(false)
  postsPerDay    Int       @default(2)
  videosPerDay   Int       @default(1)
  channels       String[]  @default([])
  lastRunAt      DateTime?
  lastRunStatus  String?
  lastRunError   String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("raalhu_autopilot_settings")
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  createdById    String
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  agentRuns    AgentRun[]

  @@index([organizationId, updatedAt])
  @@map("raalhu_conversations")
}

model ChatMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           RaalhuChatRole
  content        Json
  agentId        String?
  agentRunId     String?
  createdAt      DateTime       @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("raalhu_chat_messages")
}

enum RaalhuChatRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model AgentRun {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String?
  triggeredById  String
  status         RunStatus @default(RUNNING)
  rootAgentId    String
  model          String
  inputTokens    Int       @default(0)
  outputTokens   Int       @default(0)
  error          String?   @db.Text
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tasks        AgentTask[]

  @@index([organizationId, startedAt])
  @@map("raalhu_agent_runs")
}

model AgentTask {
  id           String    @id @default(cuid())
  agentRunId   String
  parentTaskId String?
  agentId      String
  status       RunStatus @default(RUNNING)
  input        Json
  output       Json?
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@map("raalhu_agent_tasks")
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  createdById    String?
  name           String
  objective      String?        @db.Text
  status         CampaignStatus @default(DRAFT)
  channels       String[]
  budget         Decimal?       @db.Decimal(12, 2)
  startDate      DateTime?
  endDate        DateTime?
  brief          Json?
  createdByAgent Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]

  @@index([organizationId, status])
  @@map("raalhu_campaigns")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model ContentItem {
  id             String        @id @default(cuid())
  organizationId String
  campaignId     String?
  createdById    String?
  title          String
  body           String?       @db.Text
  contentType    ContentType   @default(SOCIAL_POST)
  channel        String?
  status         ContentStatus @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  timezone       String?
  metadata       Json?
  createdByAgent Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // AI-generated visuals (Higgsfield). Video is generated from the image, so
  // it can only be requested once an image exists.
  imageStatus MediaStatus @default(NONE)
  imageUrl    String?
  imagePrompt String?     @db.Text
  imageJobId  String?
  videoStatus MediaStatus @default(NONE)
  videoUrl    String?
  videoPrompt String?     @db.Text
  videoJobId  String?
  mediaError  String?     @db.Text

  // Direct publishing to the connected social account matching `channel`.
  publishStatus   MediaStatus @default(NONE)
  publishJobId    String?
  externalPostId  String?
  externalPostUrl String?
  publishError    String?     @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, scheduledAt])
  @@index([organizationId, status])
  @@map("raalhu_content_items")
}

enum ContentType {
  SOCIAL_POST
  BLOG_POST
  EMAIL
  AD_COPY
  SCRIPT
  OTHER
}

enum ContentStatus {
  IDEA
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum MediaStatus {
  NONE
  PENDING
  READY
  FAILED
}

model Contact {
  id             String    @id @default(cuid())
  organizationId String
  name           String?
  email          String?
  phone          String?
  company        String?
  stage          LeadStage @default(LEAD)
  source         String?
  tags           String[]
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities   ContactActivity[]

  @@unique([organizationId, email])
  @@index([organizationId, stage])
  @@map("raalhu_contacts")
}

enum LeadStage {
  LEAD
  MQL
  SQL
  CUSTOMER
  CHURNED
}

model ContactActivity {
  id             String              @id @default(cuid())
  organizationId String
  contactId      String
  type           ContactActivityType
  body           String?             @db.Text
  actorUserId    String?
  createdAt      DateTime            @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@map("raalhu_contact_activity")
}

enum ContactActivityType {
  NOTE
  STAGE_CHANGE
  EMAIL
  CALL
}

model RaalhuNotification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  title          String
  body           String?   @db.Text
  type           String    @default("info")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@map("raalhu_notifications")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  actorAgentId   String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("raalhu_audit_logs")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  hashedKey      String    @unique
  lastFour       String
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("raalhu_api_keys")
}

enum SocialProvider {
  INSTAGRAM
  TIKTOK
}

// One connected account per provider per org. Tokens are encrypted at rest
// (src/lib/crypto.ts) — never selected into a client-facing response.
model SocialAccount {
  id                String         @id @default(cuid())
  organizationId    String
  provider          SocialProvider
  externalAccountId String
  displayName       String?
  accessToken       String         @db.Text
  refreshToken      String?        @db.Text
  expiresAt         DateTime?
  connectedById     String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("raalhu_social_accounts")
}
