# Runtime connection. Supabase's direct host is IPv6-only, which serverless
# platforms (e.g. Vercel) usually can't reach — use the session pooler URL
# instead (same host prefix, port 5432, username postgres.<project-ref>).
DATABASE_URL=postgresql://postgres:password@localhost:5432/raalhu
# Direct (non-pooled) connection used by `prisma migrate`. For Supabase use port 5432.
# Optional locally — falls back to DATABASE_URL.
DIRECT_URL=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (optional — credentials login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Raalhu AI ─────────────────────────────────────────────────────────
# Optional in development: without it the dashboard works but the AI team
# shows a setup banner instead of running agents.
ANTHROPIC_API_KEY=

RAALHU_DEFAULT_MODEL=claude-sonnet-5
RAALHU_FAST_MODEL=claude-haiku-4-5
RAALHU_MAX_AGENT_DEPTH=2

# Image/video generation (Higgsfield). Optional — without it, the "Generate
# image/video" controls on content items are hidden and the AI team skips
# visuals. Format is "KEY_ID:KEY_SECRET" from your Higgsfield Cloud API keys
# page (https://cloud.higgsfield.ai/api-keys).
HF_CREDENTIALS=

# Direct publishing to Instagram/TikTok. Both optional — without them, the
# "Connected accounts" tab shows "not configured" and publish controls stay
# hidden. Each requires registering a developer app with the platform and
# (for public posting) passing their app review — see docs/raalhu/data-model.md.
# Meta app (developers.facebook.com) — needs an Instagram Business/Creator
# account linked to a Facebook Page, and the instagram_content_publish
# permission (App Review).
META_APP_ID=
META_APP_SECRET=
# TikTok app (developers.tiktok.com) — Content Posting API, video.publish
# scope. Unaudited apps can only post privately (SELF_ONLY) to accounts you
# add as testers; public posting needs their review.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Any string — used to derive the AES-256 key that encrypts stored OAuth
# tokens at rest. Generate with `openssl rand -base64 32`.
SOCIAL_TOKEN_ENCRYPTION_KEY=
