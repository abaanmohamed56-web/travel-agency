# ── Shared (both apps) ────────────────────────────────────────────────
# Runtime connection. For Supabase, the transaction pooler URL (port 6543) works here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillpips
# Direct (non-pooled) connection used by `prisma migrate`. For Supabase use port 5432.
# Optional locally — falls back to DATABASE_URL.
DIRECT_URL=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (optional — credentials login works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SkillPips ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Raalhu AI ─────────────────────────────────────────────────────────
# Optional in development: without it the dashboard works but the AI team
# shows a setup banner instead of running agents.
ANTHROPIC_API_KEY=

RAALHU_DEFAULT_MODEL=claude-sonnet-5
RAALHU_FAST_MODEL=claude-haiku-4-5
RAALHU_MAX_AGENT_DEPTH=2
